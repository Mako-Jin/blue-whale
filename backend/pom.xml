<?xml version="1.0" encoding="UTF-8"?>
<!--
  BlueWhale 后端聚合 POM
  所有子模块的根聚合器
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bluewhale</groupId>
    <artifactId>whale-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>BlueWhale Backend</name>
    <description>BlueWhale 后端聚合工程 - Spring Boot 4 + Spring Cloud 微服务架构</description>

    <modules>
        <!-- 父POM -->
        <module>whale-parent</module>

        <!-- 基础组件 -->
        <module>whale-common</module>

        <!-- SDK类别 -->
        <module>whale-sdk</module>

        <!-- 服务类别 -->
        <module>whale-services</module>

        <!-- APP应用 -->
        <module>whale-apps</module>

        <!-- 运维监控 -->
        <module>whale-ops</module>

        <!-- 注册配置中心 -->
        <module>whale-registry</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
