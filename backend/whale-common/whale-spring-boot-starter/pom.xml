<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale</groupId>
        <artifactId>whale-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../whale-parent/pom.xml</relativePath>
    </parent>

    <artifactId>whale-spring-boot-starter</artifactId>
    <name>Whale Spring Boot Starter</name>
    <description>BlueWhale 自动配置 Starter - 统一异常处理、统一响应体、日志等</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- AOP：@DistributedLock 切面依赖。Spring Boot 4 已移除 spring-boot-starter-aop，
             改由 org.aspectj:aspectjweaver（BOM 统一管理版本）+ spring-aop（经 spring-context 传递）提供 -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <!-- Redisson：分布式锁实现。optional=true，仅当使用方显式引入 Redisson 时才生效 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Redis：缓存一致性工具（CacheConsistencyTemplate）使用 StringRedisTemplate。
             optional=true，仅当使用方显式引入 redis starter 时才生效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- MyBatis-Plus 3.5.9+ 将 PaginationInnerInterceptor（依赖 JSqlParser）拆分到独立构件 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- AUTH-06 权限码头：RequirePermission 注解来自 whale-auth-sdk（仅注解，无循环依赖） -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-auth-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- A5 出站日志：RestTemplateCustomizer / RestTemplateBuilder 在 Spring Boot 4 拆分为独立构件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 审计切面/脱敏器单测：JUnit 5 + Mockito + spring-test（MockHttpServletRequest / MockEnvironment） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
