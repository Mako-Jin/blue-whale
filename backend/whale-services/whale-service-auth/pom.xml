<?xml version="1.0" encoding="UTF-8"?>
<!--
  whale-service-auth - 权限中心（多模块 DDD）
  RBAC + ABAC：系统 > 菜单 > 接口 > 按钮 > 数据 > 属性
  模块顺序：domain -> application -> infrastructure -> interfaces -> starter
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale</groupId>
        <artifactId>whale-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../whale-parent/pom.xml</relativePath>
    </parent>

    <artifactId>whale-service-auth</artifactId>
    <packaging>pom</packaging>
    <name>Whale Service Auth</name>
    <description>权限中心 - RBAC + ABAC 多模块聚合工程（domain/application/infrastructure/interfaces/starter）</description>

    <modules>
        <module>whale-service-auth-domain</module>
        <module>whale-service-auth-application</module>
        <module>whale-service-auth-infrastructure</module>
        <module>whale-service-auth-interfaces</module>
        <module>whale-service-auth-starter</module>
    </modules>
</project>
