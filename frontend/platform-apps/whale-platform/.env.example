# whale-platform（qiankun 基座）环境变量模板
# 复制为 .env.local 或在 CI 构建时注入。所有变量均可选：
# 未配置 entry 时回退 //localhost:<port>（仅限本地开发）。

# ===== 子应用 entry（生产部署必填，指向网关反代地址或子应用独立域名） =====
# VITE_SUBAPP_ENTRY_PORTAL=//platform.example.com/portal
# VITE_SUBAPP_ENTRY_ERP=//platform.example.com/erp
# VITE_SUBAPP_ENTRY_OA=//platform.example.com/oa
# VITE_SUBAPP_ENTRY_MES=//platform.example.com/mes
# VITE_SUBAPP_ENTRY_PDM=//platform.example.com/pdm
# VITE_SUBAPP_ENTRY_IM=//platform.example.com/im
# VITE_SUBAPP_ENTRY_PM=//platform.example.com/pm
# VITE_SUBAPP_ENTRY_CONTRACT=//platform.example.com/contract
# VITE_SUBAPP_ENTRY_DOC=//platform.example.com/doc

# ===== 登录态回退 token（仅兼容旧子应用 host 逻辑；正常登录态经 props 注入） =====
# VITE_PLATFORM_TOKEN=
