<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.bluewhale.sts</groupId>
    <artifactId>sts-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>sts-parent</name>
    <description>父 POM —— 依赖版本统一治理，本身不含任何代码</description>

    <!--
      本模块不含任何 Java 代码，只做两件事：
        1. 定义唯一的版本号（子模块一律不写 <version>，从本模块继承）
        2. 统一收口第三方依赖版本与自制模块版本

      第三方版本尽量交给 spring-boot-starter-parent 管理，这里只声明它没管的。
    -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 第三方版本：spring-boot-starter-parent 没管的，在这里集中声明 -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ===== 自制模块：版本统一取父版本，全仓只此一处 ===== -->
            <dependency>
                <groupId>com.bluewhale.sts.common</groupId>
                <artifactId>sts-common-basic</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bluewhale.sts.common</groupId>
                <artifactId>sts-common-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bluewhale.sts.common</groupId>
                <artifactId>sts-common-db</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bluewhale.sts.server</groupId>
                <artifactId>sts-server-log</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ===== 第三方：只声明版本，不在此处引入依赖 ===== -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--
              MyBatis-Plus 自 3.5.9 起把依赖 JSqlParser 的能力（分页、防全表更新删除等拦截器）
              拆到了独立坐标，starter 不再传递引入。不显式加这一条，
              代码里 import 那些拦截器会直接编译失败 —— 报错信息只提"找不到符号"，
              很容易误判成版本写错。
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--
              springdoc 拆成两个坐标：
              - common：只提供 @Tag/@Operation/@Schema 等注解，供各服务模块编译期使用；
              - webmvc-ui：提供 /v3/api-docs 端点与 Swagger UI，只由可启动应用引入。
              这样领域服务不必背上一个 UI 依赖，而接口文档的暴露开关留在应用层（可按环境关闭）。
            -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-common</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有子模块无条件继承的依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
              与源码同目录的资源也要打进包：MyBatis Mapper XML 惯例与接口同包，
              不配这一条会在运行时提示 "Invalid bound statement (not found)"。
            -->
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                    <include>**/*.json</include>
                    <include>**/*.sql</include>
                    <include>**/*.properties</include>
                </includes>
            </resource>
        </resources>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <jvmArguments>-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8</jvmArguments>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- 显式声明注解处理器：一旦写了 annotationProcessorPaths，
                             未列出的处理器就不会被自动扫描到，新增 MapStruct 时记得一并加进来。 -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
