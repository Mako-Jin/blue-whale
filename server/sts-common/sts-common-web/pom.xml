<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale.sts.common</groupId>
        <artifactId>sts-common</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sts-common-web</artifactId>

    <name>sts-common-web</name>
    <description>Web 层公共契约：全局异常处理、响应包装 —— 通过自动配置生效</description>

    <dependencies>
        <dependency>
            <groupId>com.bluewhale.sts.common</groupId>
            <artifactId>sts-common-basic</artifactId>
        </dependency>

        <!--
          provided：Spring Web 由**最终可部署的服务**提供，本模块只编译期引用。
          若写成 compile，任何依赖本模块的库都会被强行拖入一份 Web 依赖，
          对纯后台任务模块是多余的 —— 这类污染会随依赖层级逐级放大。

          坐标是 spring-boot-starter-webmvc 而不是 spring-boot-starter-web：
          Boot 4 把 Web starter 改名为 ...-webmvc，旧名已标记 deprecated（仍能用，但会打警告）。
          新名字也更准确 —— 它对应的是 Spring MVC，与 WebFlux 明确区分开。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          compile：参数校验是**每个**服务模块都要用的公共契约。
          若不放这里，每个业务模块都得自己引一遍 spring-boot-starter-validation，
          漏引时的表现是 @Valid 静默失效 —— 校验注解还在、代码照常编译、
          非法请求却能一路进到业务逻辑。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          compile：DuplicateKeyException 在 spring-tx 里（org.springframework.dao 包，
          Spring 5 起从 spring-jdbc 拆到 spring-tx）。它由全局异常处理器引用，
          用来把"违反唯一约束"翻译成 409 而不是兜底的 500。

          **必须 compile 而不是 provided。** 异常处理器类在启动时会被反射扫描
          （@ExceptionHandler 的方法签名需要解析），provided 不传递 ——
          任何依赖本模块但没有 spring-tx 的服务模块都会在启动时
          NoClassDefFoundError，且这个失败与它写的业务代码毫无关系，极难定位。
          spring-tx 本来就随任何 MyBatis / JDBC 依赖进来，这里只是把隐含依赖写明。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!--
          compile 而非 provided：**接口文档注解是契约的一部分**，每个服务模块都要用它标注
          自己的接口。provided 不传递，若声明为 provided，每个服务模块都得重复引一行
          同一个坐标 —— 重复的依赖声明迟早有人漏写，然后靠"这个接口为什么没出现在文档里"
          来发现。这里只引 common（注解与模型），生成端点与 Swagger UI 的 webmvc-ui
          留在应用层，由应用决定是否对外暴露。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-common</artifactId>
        </dependency>
    </dependencies>

</project>
