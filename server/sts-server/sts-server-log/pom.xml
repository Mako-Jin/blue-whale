<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale.sts.server</groupId>
        <artifactId>sts-server</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sts-server-log</artifactId>

    <name>sts-server-log</name>
    <description>日志域服务：接收客户端上报日志、落库、查询与聚合</description>

    <dependencies>
        <!--
          依赖权限域是**语义上的必然**，不是图方便：日志的查询接口要判定"你有没有
          log:client:read"，而权限判定（@RequiresPermission + AuthContextHolder）
          只存在于权限域。方向是单向的 —— 权限域不依赖本模块。
          这与 sts-server-audit 依赖权限域是同一件事、同一个理由。
        -->
        <dependency>
            <groupId>com.bluewhale.sts.server</groupId>
            <artifactId>sts-server-auth</artifactId>
        </dependency>

        <dependency>
            <groupId>com.bluewhale.sts.common</groupId>
            <artifactId>sts-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bluewhale.sts.common</groupId>
            <artifactId>sts-common-db</artifactId>
        </dependency>

        <!--
          服务模块自己声明 Web 依赖，不从 sts-common-web 传递 ——
          后者用的是 provided 范围（它只提供"契约"，不提供"运行时"），
          这是有意的：谁需要运行时谁声明，依赖树才说得清。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
    </dependencies>

</project>
