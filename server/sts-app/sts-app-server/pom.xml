<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale.sts.app</groupId>
        <artifactId>sts-app</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sts-app-server</artifactId>

    <name>sts-app-server</name>
    <description>服务端应用 —— 唯一的可启动进程，组装全部后端服务模块</description>

    <!--
      本模块是"组装层"：只写依赖、配置与启动类，不写业务代码。
      业务代码一律在 sts-server-* 里 —— 把业务逻辑写进应用模块，
      等于把所有域耦合到一个不可复用的坐标上，将来拆分服务就无从下手。
    -->
    <dependencies>
        <dependency>
            <groupId>com.bluewhale.sts.server</groupId>
            <artifactId>sts-server-log</artifactId>
        </dependency>

        <!--
          行为事件域。它与日志域**并列**而不是合并：两者数据性质（技术切片 vs 业务事实）、
          保留期、采样策略、消费方全都不同，是两条独立管道 —— 详见 ADR-0011。
          合成一个模块只会让"日志的清理任务误删事件"这类事故变得可能。
        -->
        <dependency>
            <groupId>com.bluewhale.sts.server</groupId>
            <artifactId>sts-server-track</artifactId>
        </dependency>

        <!--
          权限域：身份（租户/用户/组织）与访问控制（角色/用户组/资源），
          并提供认证闭环（登录 / 登出 / 令牌）与鉴权判定入口。
          它与日志域、行为事件域并列 —— 是被各业务域**横切依赖**的能力，
          依赖方向不变（仍是 sts-app → sts-server），因此不引入跨层关系。
        -->
        <dependency>
            <groupId>com.bluewhale.sts.server</groupId>
            <artifactId>sts-server-auth</artifactId>
        </dependency>

        <!--
          spring-boot-starter-webmvc 在此**显式声明**，虽然 sts-server-log 已经带来了一份：
          可部署进程的需求不靠传递依赖表达。哪天 sts-server-log 换了实现（比如改用 WebFlux），
          传递来的依赖就没了，而本模块的启动会以一种"莫名其妙"的方式失败。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!--
          springdoc 的 UI 与 /v3/api-docs 端点只在这个可启动应用里存在：
          领域服务只需要注解（由 sts-common-web 传递），不需要对外暴露文档端点。
          生产环境可通过 springdoc.api-docs.enabled=false 直接关掉。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!--
          H2：开发 / 演示用的内存库（默认 profile），零外部依赖即可跑起来。
          runtime 范围 —— 编译期代码里不该出现任何 H2 的类，
          否则"换数据库"就会变成一件需要改代码的事。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          MySQL 驱动：mysql profile 用。同样只放 runtime —— 代码里没有任何一处
          依赖 MySQL 的类，"用哪个库"是启动参数决定的，不是编译期决定的。
          版本由 spring-boot-starter-parent 纳管（${mysql.version}），此处不写版本号。
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          数据库迁移。spring-boot-starter-flyway 带来 flyway-core 与 JDBC 支持。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!--
          flyway-mysql：**必加，且不是可选优化**。

          Flyway 10 起把各数据库的支持拆成了独立模块，flyway-core 只内置
          H2 / SQLite（可在 core 的 jar 里看到 org/flywaydb/core/internal/database/h2/，
          却没有任何 mysql 包）。少了这一条，H2 profile 一切正常，
          而 mysql profile 会在启动时抛
          "Unsupported Database: MySQL 8.0" —— 编译期毫无征兆。

          这与 MyBatis-Plus 拆出 mybatis-plus-jsqlparser 是同一类陷阱：
          starter 不再传递引入全部数据库支持，谁用谁声明。
          版本同样由 spring-boot-starter-parent 纳管。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          达梦 DM8 驱动：dameng profile 用。同样只放 runtime —— 代码里没有任何一处
          引用达梦的类（dm.jdbc.*），"用哪个库"始终是启动参数决定的。
          版本由 sts-parent 统一收口（Boot 的 BOM 不纳管 com.dameng）。

          注意这里**没有**、也不该有 flyway-dameng 这种坐标：Flyway 官方不存在达梦模块。
          达梦下不启用 Flyway，表结构走交付脚本，理由见 application-dameng.yml。
        -->
        <dependency>
            <groupId>com.dameng</groupId>
            <artifactId>DmJdbcDriver18</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          MockMvc 测试支持。Boot 4 把测试设施也按技术栈拆开了：
          @AutoConfigureMockMvc / @WebMvcTest 从 spring-boot-test-autoconfigure
          挪到了独立的 spring-boot-webmvc-test 模块（注解也随之换包）。
          只引 spring-boot-starter-test 会在编译测试代码时报"找不到符号"。

          test 范围：只在测试里生效，不进产物。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打可执行 jar，mvn package 后可直接 java -jar 启动 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
