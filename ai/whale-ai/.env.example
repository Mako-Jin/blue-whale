# whale-ai 运行配置（复制为 .env 或由部署环境注入）
# 服务监听：仅内网，默认环回地址；不注册网关、不注册 Nacos
WHALE_AI_HOST=127.0.0.1
WHALE_AI_PORT=8092
WHALE_AI_LOG_LEVEL=INFO

# 记忆与编排预算（M3 后续任务使用）
WHALE_AI_REDIS_URL=redis://127.0.0.1:6379/0
WHALE_AI_MEMORY_TTL_SECONDS=604800
WHALE_AI_MAX_TOOL_STEPS=6
WHALE_AI_TOOL_TIMEOUT_SECONDS=20
WHALE_AI_TOTAL_BUDGET_SECONDS=120
# 只读工具执行方：whale-agent 内网地址（工具接口 /agent/tools/**）
WHALE_AI_AGENT_BASE_URL=http://127.0.0.1:8090
# 仓库根目录：配置后引用校验会检查文件存在性并裁剪行号，留空只做结构校验
WHALE_AI_REPO_ROOT=
# 检索条数与事实条数
WHALE_AI_SEARCH_TOP_K=8
WHALE_AI_FACT_LIMIT=8

# 模型沿用 whale-agent 的 OpenAI 兼容变量，Python 侧不另立密钥
WHALE_AGENT_LLM_ENABLED=true
WHALE_AGENT_LLM_BASE_URL=https://api.openai.com/v1
WHALE_AGENT_LLM_API_KEY=
WHALE_AGENT_LLM_MODEL=gpt-4o-mini
WHALE_AGENT_LLM_TIMEOUT_MILLIS=60000
WHALE_AGENT_LLM_MAX_TOKENS=1024
WHALE_AGENT_LLM_TEMPERATURE=0.2
