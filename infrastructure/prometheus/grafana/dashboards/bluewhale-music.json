{
  "uid": "bluewhale-music",
  "title": "音乐平台监控（Wave 5.75）",
  "description": "whale-music 首页 / 详情 / 流式首字节时延（SLO-6/7/8）、流量、错误与连接池视图；口径见 docs/ops/slo.md。",
  "tags": ["bluewhale", "music", "slo"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "SLO（P95 由 http_server_requests_seconds_bucket 计算）",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "音乐首页 P95（SLO-6 < 300ms）",
      "description": "GET /music/home，application=whale-music",
      "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"whale-music\",uri=\"/music/home\"}[5m])))",
          "instant": true,
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.2 }, { "color": "red", "value": 0.3 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "歌曲详情 P95（SLO-7 < 200ms）",
      "description": "GET /music/public/song/{id}",
      "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"whale-music\",uri=\"/music/public/song/{id}\"}[5m])))",
          "instant": true,
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.15 }, { "color": "red", "value": 0.2 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "流式首字节 P95（SLO-8 < 300ms）",
      "description": "GET /music/stream/{songId}，含上游 whale-file 内容接口耗时",
      "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"whale-music\",uri=\"/music/stream/{songId}\"}[5m])))",
          "instant": true,
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.2 }, { "color": "red", "value": 0.3 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "抓取目标存活（up）",
      "description": "job=whale-music，1=存活，0=失联（对应 ServiceDown 告警）",
      "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "up{job=\"whale-music\"}",
          "instant": true,
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "流量与时延趋势",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "端点 QPS（首页 / 详情 / 流式 / 票据）",
      "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"whale-music\",uri=~\"/music/(home|public/song/{id}|stream/{songId}|play/ticket)\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "端点 P95 趋势（SLO-6/7/8）",
      "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"whale-music\",uri=\"/music/home\"}[5m])))",
          "legendFormat": "首页"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"whale-music\",uri=\"/music/public/song/{id}\"}[5m])))",
          "legendFormat": "详情"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"whale-music\",uri=\"/music/stream/{songId}\"}[5m])))",
          "legendFormat": "流式首字节"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "5xx 错误率（按端点）",
      "description": "5xx 占比超过 5% 触发 Http5xxRateHigh 告警",
      "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"whale-music\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"whale-music\"}[5m]))",
          "legendFormat": "5xx 占比"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.05 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "title": "资源与依赖",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "type": "timeseries",
      "title": "Hikari 连接（活跃 / 空闲 / 等待 / 上限）",
      "description": "DB_POOL_MAX_SIZE 默认 5；等待数长期 > 0 说明连接池偏小",
      "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "hikaricp_connections_active{application=\"whale-music\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "hikaricp_connections_idle{application=\"whale-music\"}",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "hikaricp_connections_pending{application=\"whale-music\"}",
          "legendFormat": "pending"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "hikaricp_connections_max{application=\"whale-music\"}",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "JVM 堆使用率",
      "description": "堆使用率 > 85% 触发 JvmHeapHigh 告警",
      "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "bluewhale-prometheus" },
          "expr": "sum(jvm_memory_used_bytes{application=\"whale-music\",area=\"heap\"}) / sum(jvm_memory_max_bytes{application=\"whale-music\",area=\"heap\"})",
          "legendFormat": "heap used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.75 }, { "color": "red", "value": 0.85 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
