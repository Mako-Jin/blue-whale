# ============================================================
# 蓝鲸系统 - 环境变量示例
# 复制为 .env 并按实际情况修改（.env 不入仓）
# ============================================================

# ---------- 宿主机端口映射（与本地已装中间件冲突时改这里） ----------
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
NACOS_HOST_PORT=8848
NACOS_GRPC_HOST_PORT=9848
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3000
NGINX_HTTP_HOST_PORT=80
NGINX_HTTPS_HOST_PORT=443

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_root_pwd
MYSQL_USER=whale_user
MYSQL_PASSWORD=change_me_user_pwd

# 容器内访问地址（服务跑在容器内时使用）
MYSQL_HOST=mysql
MYSQL_PORT=3306

# 业务数据库连接串（宿主机调试时把 mysql 换成 127.0.0.1）
MYSQL_URL_AUTH=jdbc:mysql://mysql:3306/bluewhale_auth?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_general_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_JOB=jdbc:mysql://mysql:3306/bluewhale_job?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_general_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_WORKFLOW=jdbc:mysql://mysql:3306/bluewhale_workflow?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_general_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_FORM=jdbc:mysql://mysql:3306/bluewhale_form?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_general_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_FILE=jdbc:mysql://mysql:3306/bluewhale_file?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_general_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_MONITOR=jdbc:mysql://mysql:3306/bluewhale_monitor?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_general_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_AUDIT=jdbc:mysql://mysql:3306/bluewhale_audit?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_general_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_pwd

# ---------- Nacos ----------
NACOS_HOST=nacos
NACOS_PORT=8848
# 身份标识（服务端身份校验）
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=change_me_nacos_identity
# JWT 签名密钥（Base64，解码后至少 32 字节）；生成:
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }))
NACOS_AUTH_TOKEN=change_me_base64_token_at_least_32_bytes
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ---------- JWT ----------
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
# 注：JWT 过期时间在后端各服务 application.yml 的 `expire-minutes` 配置，
# 不经环境变量注入（历史上 JWT_EXPIRE_MS / JWT_EXPIRE_HOURS 均为无效变量，已删除）。

# ---------- RabbitMQ (AUTH-10 审计 MQ 汇聚) ----------
# docker-compose 对这两个变量做了无默认值校验：不配置会启动失败而非以 guest/guest 上线
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=change_me_rabbitmq_user
RABBITMQ_PASSWORD=change_me_rabbitmq_pwd

# ---------- 镜像 ----------
# 国内网络无法直连 Docker Hub 时指向镜像站，例如 docker.m.daocloud.io/library/nginx:alpine
NGINX_BASE_IMAGE=nginx:alpine
MYSQL_BASE_IMAGE=mysql:8.4
REDIS_BASE_IMAGE=redis:7-alpine
# 中间件镜像（直连 Docker Hub 失败时整体替换前缀，例如 docker.m.daocloud.io/）
NACOS_IMAGE=nacos/nacos-server:v2.4.0
RABBITMQ_IMAGE=rabbitmq:4-management-alpine

# ---------- 可观测性（REQ-ARCH-007） ----------
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0
GRAFANA_IMAGE=grafana/grafana:11.2.0
PROMETHEUS_RETENTION=15d
# Grafana 管理员口令仅用于本地/内网，生产必须替换
GRAFANA_ADMIN_PASSWORD=change_me_grafana_pwd

# ---------- TLS ----------
# 证书目录固定为 infrastructure/docker/nginx/ssl（fullchain.pem / privkey.pem）
# 开发环境可执行 infrastructure/scripts/gen-dev-cert.ps1 生成自签证书
TLS_SERVER_NAME=bluewhale.local

# ---------- 应用 ----------
SW_VERSION=0.1.0
SW_PROFILES_ACTIVE=dev
TZ=Asia/Shanghai

# ---------- 内网令牌（V-02 纵深防御） ----------
# 服务间 /internal/** 接口共享令牌（V-02；未设置时非 dev 环境服务将拒绝启动）
WHALE_INTERNAL_TOKEN=
