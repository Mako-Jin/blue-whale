# ============================================================
# 蓝鲸系统 - 环境变量示例
# 复制为 .env 并按实际情况修改
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_root_pwd
MYSQL_USER=whale_user
MYSQL_PASSWORD=change_me_user_pwd
MYSQL_HOST=mysql
MYSQL_PORT=3306

# 业务数据库连接串 (供 Spring Boot 使用)
MYSQL_URL_AUTH=jdbc:mysql://mysql:3306/whale_auth?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_JOB=jdbc:mysql://mysql:3306/whale_job?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_WORKFLOW=jdbc:mysql://mysql:3306/whale_workflow?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_FORM=jdbc:mysql://mysql:3306/whale_form?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_FILE=jdbc:mysql://mysql:3306/whale_file?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_MONITOR=jdbc:mysql://mysql:3306/whale_monitor?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_URL_AUDIT=jdbc:mysql://mysql:3306/whale_audit?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_pwd

# ---------- Nacos ----------
NACOS_HOST=nacos
NACOS_PORT=8848
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=change_me_nacos_pwd
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ---------- JWT ----------
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
JWT_EXPIRE_HOURS=24

# ---------- RabbitMQ (可选) ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---------- 应用 ----------
SW_VERSION=0.1.0
SW_PROFILES_ACTIVE=dev
TZ=Asia/Shanghai
