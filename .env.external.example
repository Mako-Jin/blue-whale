# ============================================================
# P0 外部接入凭据模板（S-04d-2 / S-04e-2 / V-11 / F-03b / V-06）
# 复制为仅部署机持有的 .env.external 并按供应商实际值填写。
# 不要提交真实凭据、私钥、手机号或回调密钥；仓库只保留空值模板。
# 填写后先运行：
#   pwsh -NoProfile -File scripts/smoke/bw-external-integration-preflight.ps1 -EnvFile .env.external
# ============================================================

# ===== 合同电子签：渠道选择 =====
# local 仅允许 dev；生产必须为 esignbao / fadada / ssq
CONTRACT_ESIGN_PROVIDER=esignbao
# 生产必须替换为随机值，且与供应商回调配置一致
CONTRACT_ESIGN_CALLBACK_SECRET=

# --- e签宝沙箱/生产 ---
CONTRACT_ESIGN_ESIGNBAO_BASE_URL=
CONTRACT_ESIGN_ESIGNBAO_APP_ID=
CONTRACT_ESIGN_ESIGNBAO_APP_SECRET=
CONTRACT_ESIGN_ESIGNBAO_NOTIFY_URL=
CONTRACT_ESIGN_ESIGNBAO_SIGN_URL=

# --- 法大大沙箱/生产 ---
CONTRACT_ESIGN_FADADA_BASE_URL=
CONTRACT_ESIGN_FADADA_APP_ID=
CONTRACT_ESIGN_FADADA_APP_SECRET=
CONTRACT_ESIGN_FADADA_NOTIFY_URL=
CONTRACT_ESIGN_FADADA_SIGN_URL=

# --- 上上签沙箱/生产 ---
CONTRACT_ESIGN_SSQ_BASE_URL=
CONTRACT_ESIGN_SSQ_APP_ID=
CONTRACT_ESIGN_SSQ_APP_SECRET=
CONTRACT_ESIGN_SSQ_NOTIFY_URL=
CONTRACT_ESIGN_SSQ_SIGN_URL=

# ===== 持牌 CA / 时间戳 =====
# PEM 证书链（可多张证书），生产必须提供持牌 CA 信任根
CONTRACT_ESIGN_CA_CERT_PATH=
# PEM 或 DER CRL，生产建议提供
CONTRACT_ESIGN_CA_CRL_PATH=
# 平台侧 PKCS#12；三方渠道由供应商签署时可留空
CONTRACT_ESIGN_P12_PATH=
CONTRACT_ESIGN_P12_PASSWORD=
# RFC 3161 TSA；生产建议 TSA_REQUIRED=true
CONTRACT_ESIGN_TSA_URL=
CONTRACT_ESIGN_TSA_USERNAME=
CONTRACT_ESIGN_TSA_PASSWORD=
CONTRACT_ESIGN_TSA_REQUIRED=true
CONTRACT_ESIGN_TSA_TIMEOUT=5000

# ===== 告警短信（F-03b：统一 HTTP 网关） =====
# 网关需接收 JSON：phones/templateCode/signName/content + 告警元数据
ALERT_SMS_ENABLED=false
ALERT_SMS_URL=
ALERT_SMS_TOKEN=
ALERT_SMS_TO=
ALERT_SMS_TEMPLATE_CODE=BLUEWHALE_ALERT
ALERT_SMS_SIGN_NAME=
ALERT_SMS_TIMEOUT=3000

# ===== 告警邮件（V-06 至少需要邮件或短信一个真实通道） =====
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ===== Alertmanager 入站与出站 Webhook =====
ALERT_WEBHOOK_TOKEN=
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT=3000

# ===== 合同实名 / 意愿认证 =====
# 当前仓库尚无供应商实名协议；凭据到位并完成适配后再在此新增变量，
# 不要用自定义字段冒充实名证据。
