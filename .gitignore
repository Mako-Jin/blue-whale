.uv/

# ===== OS =====
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ===== Docker =====
docker-compose.override.yml
# 但部署模板目录下的 override 是待下发资产（资源限额/日志轮转），必须入库
!deploy/mail/docker-compose.override.yml

# ===== Secrets =====
.env
.env.local
.env.*.local
# P0 外部凭据文件只允许存在于部署机，模板 .env.external.example 入库
.env.external
.env.external.local
*.pem
*.key
*.crt
*.p12
*.jks

# ===== Build Output =====
# 根锚定：无前导 / 会静默忽略任意层级同名目录（曾吞掉 src/*/data/、src/**/out/ 等合法源码目录）
/build/
/out/
/coverage/
*.lcov

# ===== Local Runtime Data =====
# whale-agent 本地 Lucene 索引（可重建，不入库；含 data/agent-index/）
# 根锚定：只忽略仓库根的 data/，不影响各模块 src/main/resources/data/ 等合法目录
/data/
# Tomcat / 容器临时工作目录（根目录，不入库）
/work/
# 本地代理工具状态（不入库）
/.workbuddy/
# 临时日志目录（根目录）
/.tmp/
# 根目录截图产物
/.screenshots/
# Derby 运行日志（*.log 已覆盖，显式登记避免规则调整后遗漏）
derby.log
# 本机 Redis 持久化文件（运行时生成，不入库）
dump.rdb

# ===== Logs =====
/logs/
*.log

# ===== Temp =====
/tmp/
/temp/
*.tmp
*.swp
*.swo
*~
*.crdownload

# ===== Local Tools (本地下载的第三方软件/压缩包，不入库；仅匹配仓库根目录，避免误伤 com/bluewhale/tools 包) =====
/tools/

# ===== Local Skills (本地下载的 skill 压缩包，不入库；skill 源文件如需共享请另建目录) =====
/skills/*.zip
