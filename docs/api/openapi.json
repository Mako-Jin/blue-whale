              }
            }
          }
        }
      }
    },
    "/api/logs/client/trace/{traceId}": {
      "get": {
        "tags": [
          "客户端日志"
        ],
        "summary": "按链路标识查询整条链路",
        "description": "按发生时间**升序**返回，便于直接按顺序阅读。",
        "operationId": "listByTraceId",
        "parameters": [
          {
            "name": "traceId",
            "in": "path",
            "description": "链路标识",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RListClientLogVO"
                }
              }
            }
          }
        }
      }
    },
    "/api/logs/client/stats": {
      "get": {
        "tags": [
          "客户端日志"
        ],
        "summary": "按级别聚合统计",
        "description": "返回时间窗内的总条数与各级别分布，包含条数为 0 的级别。",
        "operationId": "stats",
        "parameters": [
          {
            "name": "app",
            "in": "query",
