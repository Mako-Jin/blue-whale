  "components": {
    "schemas": {
      "ClientLogItem": {
        "type": "object",
        "description": "单条客户端日志",
        "properties": {
          "level": {
            "type": "string",
            "description": "级别，取值 trace/debug/perf/info/success/warn/error",
            "example": "info"
          },
          "namespace": {
            "type": "string",
            "description": "命名空间，形如 app › auth › login",
            "example": "app › auth"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "客户端时间戳（毫秒），服务端仅作参考不用于排序"
          },
          "message": {
            "type": "string",
            "description": "消息正文",
            "example": "用户登录成功"
          },
          "data": {
            "type": "array",
            "description": "随消息附带的原始数据",
            "items": {}
          },
          "context": {
            "type": "object",
            "additionalProperties": {},
            "description": "结构化上下文"
          },
          "traceId": {
            "type": "string",
            "description": "链路标识"
          },
          "sessionId": {
            "type": "string",
            "description": "会话标识"
          },
          "route": {
            "type": "string",
            "description": "触发日志时的路由"
          },
          "release": {
            "type": "string",
            "description": "应用版本 / 构建号"
          }
        }
      },
      "ClientLogReportRequest": {
        "type": "object",
        "description": "客户端日志批量上报请求",
        "properties": {
          "app": {
            "type": "string",
            "description": "上报方应用标识",
            "example": "platform-log-console",
            "maxLength": 64,
            "minLength": 0
          },
          "release": {
            "type": "string",
            "description": "应用版本 / 构建号",
            "example": "0.1.0",
            "maxLength": 64,
            "minLength": 0
          },
          "sessionId": {
            "type": "string",
            "description": "会话标识，批次级默认值",
            "maxLength": 64,
            "minLength": 0
          },
          "logs": {
            "type": "array",
            "description": "日志条目，单批最多 500 条",
            "items": {
              "$ref": "#/components/schemas/ClientLogItem"
            },
            "maxItems": 500,
            "minItems": 0
          }
        },
        "required": [
          "app",
          "logs"
        ]
      },
      "ClientLogReportResultVO": {
        "type": "object",
        "description": "批量上报结果",
        "properties": {
          "accepted": {
            "type": "integer",
            "format": "int32",
            "description": "成功落库的条数"
          },
          "rejected": {
            "type": "integer",
            "format": "int32",
            "description": "被拒绝的条数（级别非法、消息为空等）"
          }
        }
      },
      "RClientLogReportResultVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/ClientLogReportResultVO"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ClientEventItem": {
        "type": "object",
        "description": "单条客户端行为事件",
        "properties": {
          "eventId": {
            "type": "string",
            "description": "客户端生成的事件唯一 id，用于幂等去重",
            "example": "01J8Z0QW7X9K3M"
          },
          "eventName": {
            "type": "string",
            "description": "事件名，小写点分、至少两段，形如 order.submit",
            "example": "order.submit"
          },
          "userId": {
            "type": "string",
            "description": "登录用户标识，未登录时为空"
          },
          "deviceId": {
            "type": "string",
            "description": "匿名设备标识"
          },
          "sessionId": {
            "type": "string",
            "description": "会话标识"
          },
          "route": {
            "type": "string",
            "description": "触发事件时的路由"
          },
          "release": {
            "type": "string",
            "description": "应用版本 / 构建号"
          },
          "props": {
            "type": "object",
            "additionalProperties": {},
            "description": "事件属性"
          },
          "propsVersion": {
            "type": "integer",
            "format": "int32",
            "description": "属性结构版本，props 结构变化必须递增",
            "example": 1
          },
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "客户端时间戳（毫秒），服务端仅作参考不用于排序"
          }
        }
      },
      "ClientEventReportRequest": {
        "type": "object",
        "description": "客户端行为事件批量上报请求",
        "properties": {
          "app": {
            "type": "string",
            "description": "上报方应用标识",
            "example": "platform-web",
            "maxLength": 64,
            "minLength": 0
          },
          "release": {
            "type": "string",
            "description": "应用版本 / 构建号",
            "example": "0.1.0",
            "maxLength": 64,
            "minLength": 0
          },
          "sessionId": {
            "type": "string",
            "description": "会话标识，批次级默认值",
            "maxLength": 64,
            "minLength": 0
          },
          "events": {
            "type": "array",
            "description": "事件条目，单批最多 500 条",
            "items": {
              "$ref": "#/components/schemas/ClientEventItem"
            },
            "maxItems": 500,
            "minItems": 0
          }
        },
        "required": [
          "app",
          "events"
        ]
      },
      "ClientEventReportResultVO": {
        "type": "object",
        "description": "批量上报结果",
        "properties": {
          "accepted": {
            "type": "integer",
            "format": "int32",
            "description": "成功落库的条数"
          },
          "rejected": {
            "type": "integer",
            "format": "int32",
            "description": "被拒绝的条数（事件名为空 / 长度超限 / 格式非法等）"
          }
        }
      },
      "RClientEventReportResultVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/ClientEventReportResultVO"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ClientLogVO": {
        "type": "object",
        "description": "客户端日志",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "日志主键"
          },
          "app": {
            "type": "string",
            "description": "上报方应用标识"
          },
          "level": {
            "type": "string",
            "description": "级别"
          },
          "namespace": {
            "type": "string",
            "description": "命名空间"
          },
          "message": {
            "type": "string",
            "description": "消息正文"
          },
          "data": {
            "type": "array",
