{
  "openapi": "3.1.0",
  "info": {
    "title": "BlueWhale 服务端 API",
    "description": "统一响应约定：**业务结果只由 `code` 表达，业务失败同样返回 HTTP 200**，\n调用方统一判断 `code === 0`。传输层失败（401/403/404/5xx）由框架按标准返回，不套统一包装。\n",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "客户端日志",
      "description": "接收前端上报的技术日志、查询与聚合；审计日志不走本接口"
    },
    {
      "name": "系统",
      "description": "服务自身状态"
    },
    {
      "name": "客户端行为事件",
      "description": "接收前端上报的行为事件、查询与按事件名聚合"
    }
  ],
  "paths": {
    "/api/logs/client": {
      "get": {
        "tags": [
          "客户端日志"
        ],
        "summary": "分页查询客户端日志",
        "description": "按服务端接收时间倒序。时间窗缺省为最近 7 天。",
        "operationId": "page",
        "parameters": [
          {
            "name": "app",
            "in": "query",
            "description": "上报方应用标识",
            "required": false,
            "schema": {
              "type": "string",
              "description": "上报方应用标识"
            }
          },
          {
            "name": "level",
            "in": "query",
            "description": "级别精确匹配，取值 trace/debug/perf/info/success/warn/error",
            "required": false,
            "schema": {
              "type": "string",
              "description": "级别精确匹配，取值 trace/debug/perf/info/success/warn/error"
            }
          },
          {
            "name": "namespace",
            "in": "query",
            "description": "命名空间精确匹配",
            "required": false,
            "schema": {
              "type": "string",
              "description": "命名空间精确匹配"
            }
          },
          {
            "name": "traceId",
            "in": "query",
            "description": "链路标识精确匹配",
            "required": false,
            "schema": {
              "type": "string",
              "description": "链路标识精确匹配"
            }
          },
          {
            "name": "sessionId",
            "in": "query",
            "description": "会话标识精确匹配",
            "required": false,
            "schema": {
              "type": "string",
              "description": "会话标识精确匹配"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "消息正文模糊匹配",
            "required": false,
            "schema": {
              "type": "string",
              "description": "消息正文模糊匹配"
            }
          },
          {
            "name": "startTime",
            "in": "query",
            "description": "起始时间（毫秒，含）；缺省为 endTime 之前 7 天",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "起始时间（毫秒，含）；缺省为 endTime 之前 7 天"
            }
          },
          {
            "name": "endTime",
            "in": "query",
            "description": "结束时间（毫秒，含）；缺省为当前时间",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "结束时间（毫秒，含）；缺省为当前时间"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RPageResultClientLogVO"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "客户端日志"
        ],
        "summary": "批量上报客户端日志",
        "description": "单批最多 500 条。信封级错误整批拒绝（40000）；条目级错误逐条跳过并在返回值中计数。",
        "operationId": "report",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientLogReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RClientLogReportResultVO"
                }
              }
            }
          }
        }
      }
    },
