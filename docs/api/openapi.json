            }
          },
          {
            "name": "endTime",
            "in": "query",
            "description": "结束时间（毫秒，含）；缺省为当前时间",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "结束时间（毫秒，含）；缺省为当前时间"
            }
          }
        ],
        "responses": {
          "200": {
