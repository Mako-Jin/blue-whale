            }
          }
        }
      },
      "post": {
        "tags": [
          "客户端行为事件"
        ],
        "summary": "批量上报客户端行为事件",
        "description": "单批最多 500 条。信封级错误整批拒绝（40000）；条目级错误逐条跳过并在返回值中计数。",
        "operationId": "report_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientEventReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RClientEventReportResultVO"
                }
              }
            }
          }
        }
      }
    },
    "/api/logs/client/{id}": {
      "get": {
        "tags": [
          "客户端日志"
        ],
        "summary": "查询日志详情",
