# ============================================
# 蓝鲸系统 - 环境变量示例
# 复制此文件为 .env 并填入真实值
# ============================================

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=change_me_root_pwd
MYSQL_USER=bluewhale
MYSQL_PASSWORD=change_me_user_pwd
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ===== Redis =====
REDIS_PASSWORD=change_me_redis_pwd
REDIS_HOST=redis
REDIS_PORT=6379

# ===== Nacos =====
NACOS_AUTH_IDENTITY_KEY=nacos
NACOS_AUTH_IDENTITY_VALUE=nacos
NACOS_HOST=nacos
NACOS_PORT=8848

# ===== JWT =====
JWT_SECRET=please_change_this_to_a_very_long_random_string
JWT_EXPIRE_MS=86400000

# ===== 各服务端口 =====
GATEWAY_PORT=8080
AUTH_PORT=8081
JOB_PORT=8082
WORKFLOW_PORT=8083
FORM_PORT=8084
FILE_PORT=8085
PAY_PORT=8086
MONITOR_PORT=8087
AUDIT_PORT=8088

# ===== 前端 =====
PLATFORM_PORT=8000
PORTAL_PORT=8101
ERP_PORT=8102
OA_PORT=8103
ADMIN_PORT=8080
OPS_PORT=8081
