<?xml version="1.0" encoding="UTF-8"?>
<!-- 启动模块：聚合四层 + 运行时依赖 + 资源 + 测试，产出可部署 jar（whale-service-auth.jar） -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale</groupId>
        <artifactId>whale-service-auth</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>whale-service-auth-starter</artifactId>
    <name>Whale Service Auth Starter</name>
    <description>权限中心启动模块 - 可部署服务</description>

    <dependencies>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-auth-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-auth-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-auth-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-auth-interfaces</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- P2-3：OpenAPI 契约导出（/v3/api-docs）与 Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- P1-3b：暴露 /actuator/prometheus 供 Prometheus 抓取 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Redis：登出令牌黑名单。StringRedisTemplate 为懒连接，Redis 不可用时鉴权链路降级 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- REQ-SEC-022：Flyway 数据库版本化管理（试点服务），脚本位于 classpath:db/migration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
        <!-- AUTH-10：审计 MQ 汇聚生产者（试点服务），未开启 whale.audit.mq.publish-enabled 时不发消息 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-tools</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-auth-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 国际化 starter：本服务库自动建 sys_i18n_message + 自带 i18n/auth 文案 + 本地管理接口 -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-i18n-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Web 适配层装配器：DTO ↔ Command/Query/Result 编译期映射，版本由 whale-parent 统一管理 -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>whale-service-auth</finalName>
        <plugins>
            <!--
              classifier=exec：把 Spring Boot 可执行包（fat jar）作为附加构件，主构件保持普通 jar。

              原因：不加 classifier 时 repackage 会用 fat jar 顶替主构件，本模块被
              whale-service-auth-architecture-test 以 test 作用域依赖后，ArchUnit 拿到的是
              fat jar——类都在 BOOT-INF/classes 下，importer 一个都扫不到，
              规则报 "failed to check any classes"（CI Backend run#36 实证）。

              产物：target/whale-service-auth.jar（普通 jar，供依赖）
                    target/whale-service-auth-exec.jar（fat jar，供部署）
              Docker 侧见 deploy/backend/sample/Dockerfile 的 jar 选择逻辑（优先 -exec.jar）。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
