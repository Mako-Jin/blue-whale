<?xml version="1.0" encoding="UTF-8"?>
<!--
  whale-service-gateway - API 网关
  基于 Spring Cloud Gateway（响应式，非 Servlet 栈）
  注意：不能引入 spring-boot-starter-web，需用 spring-cloud-starter-gateway
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale</groupId>
        <artifactId>whale-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../whale-parent/pom.xml</relativePath>
    </parent>

    <artifactId>whale-service-gateway</artifactId>
    <name>Whale Gateway</name>
    <description>API 网关 - Spring Cloud Gateway</description>

    <dependencies>
        <!-- Spring Cloud Gateway 5.x（响应式 WebFlux，不能和 spring-boot-starter-web 同时使用） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- G2 熔断：resilience4j 替换自研状态机（CircuitBreakerGlobalFilter 使用 tryAcquirePermission + onSuccess/onError 手动驱动状态机） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- 响应式 Redis：校验令牌登出黑名单（REQ-SEC-003）。WebFlux 栈只能用 reactive 版 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <!-- 与 whale-auth 共用黑名单键约定（TokenBlacklistKeys），避免两侧键格式漂移 -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 语言标签归一化（LocaleSupport）：网关与服务端共用同一套支持语言口径 -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-common-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- REQ-SEC-020：配置 ENC(...) 密文解密（仅依赖 spring-boot + jasypt，不引入 Servlet 栈） -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-config-crypto</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- JWT（jjwt 0.12.x API，与 whale-auth 签发侧约定一致；版本由 whale-parent 统一管理，AUTH-02） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- P1-3b：暴露 /actuator/prometheus 供 Prometheus 抓取 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- E-1 分布式追踪：Micrometer Tracing → OTel 桥接，WebFlux 自动为每个请求创建 span。
             只依赖桥接与 OTLP 导出器，不引入 agent，保持零侵入 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- E-2 JWKS 本地缓存：按 kid 缓存公钥，TTL 与容量有界 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
