<?xml version="1.0" encoding="UTF-8"?>
<!-- 领域层：聚合根、值对象、仓储端口与存储端口。仅依赖通用异常/基础能力，不依赖 Web/持久化 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale</groupId>
        <artifactId>whale-service-file</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>whale-service-file-domain</artifactId>
    <packaging>jar</packaging>
    <name>Whale Service File Domain</name>
    <description>文件服务领域层 - 文件聚合根、状态值对象、仓储端口与存储端口</description>

    <dependencies>
        <!-- BizException / ErrorCode 等统一异常契约 -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-common-core</artifactId>
        </dependency>
        <!-- 通用领域基座：Entity / ValueObject / DomainEvent / DomainException -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-common-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
