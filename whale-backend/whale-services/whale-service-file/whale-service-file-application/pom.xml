<?xml version="1.0" encoding="UTF-8"?>
<!-- 应用层：用例编排（上传下载、秒传、分片与配额）+ 命令/查询 + 视图对象。仅依赖领域层与基础能力 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale</groupId>
        <artifactId>whale-service-file</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>whale-service-file-application</artifactId>
    <packaging>jar</packaging>
    <name>Whale Service File Application</name>
    <description>文件服务应用层 - 上传下载、秒传、分片与配额业务编排</description>

    <dependencies>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-file-domain</artifactId>
        </dependency>
        <!-- FileProperties：上传上限、配额、分片大小与存储根目录等配置 -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-file-starter</artifactId>
        </dependency>
        <!-- Spring Web / BizException / PageResult / TenantContext 等基础能力 -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
