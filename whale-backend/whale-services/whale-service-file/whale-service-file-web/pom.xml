<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale</groupId>
        <artifactId>whale-service-file</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>whale-service-file-web</artifactId>
    <packaging>jar</packaging>
    <name>Whale Service File Web</name>
    <description>文件服务启动与可部署模块</description>

    <dependencies>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-file-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-file-interfaces</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-file-infrastructure</artifactId>
        </dependency>
        <!-- 默认存储插件：本地磁盘兜底 + MinIO 对象存储按配置启用 -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-file-plugins-local</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-file-plugins-minio</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- P1-3b：暴露 /actuator/prometheus 供 Prometheus 抓取 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- REQ-SEC-022：Flyway 数据库版本化管理（阶段 4 铺开），脚本位于 classpath:db/migration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!-- Result / BizException / MyBatis-Plus 自动填充 / 权限码头拦截：经本 starter 传递引入 -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-tools</artifactId>
        </dependency>
        <!-- 国际化 starter：本服务库自动建 sys_i18n_message + 自带 i18n/file 文案 -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-i18n-sdk</artifactId>
        </dependency>
        <!-- Web 适配层：应用层结果 → 接口层响应 的 MapStruct 装配 -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <!-- 概览契约 SDK（三维王城藏书殿 T5.4）：只提供缓存/超时/降级与 GET /file/overview 端点，
             缓存与降级不在服务侧重复实现 -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-overview-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 保持可部署 jar 名与既有启动脚本/镜像约定一致 -->
        <finalName>whale-file</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
