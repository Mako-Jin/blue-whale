<?xml version="1.0" encoding="UTF-8"?>
<!-- 架构守护测试层：仅含 ArchUnit 测试，校验 DDD 分层依赖方向（无生产代码） -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale</groupId>
        <artifactId>whale-service-file</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>whale-service-file-architecture-test</artifactId>
    <packaging>jar</packaging>
    <name>Whale Service File Architecture Test</name>
    <description>文件服务架构守护测试 - ArchUnit 校验分层依赖方向</description>

    <properties>
        <!-- 本模块无生产代码，跳过覆盖率统计，避免空覆盖率 bundle 触发门禁误报 -->
        <jacoco.skip>true</jacoco.skip>
    </properties>

    <dependencies>
        <!-- 各层均以测试作用域引入：本模块仅承载架构校验，不产出可部署代码 -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-file-domain</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-file-application</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-file-interfaces</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-service-file-infrastructure</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
