<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bluewhale</groupId>
        <artifactId>whale-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../whale-parent/pom.xml</relativePath>
    </parent>

    <artifactId>whale-pay-client</artifactId>
    <name>Whale Pay Client SDK</name>
    <description>支付内网客户端 SDK - 统一令牌/租户/链路头、幂等键与重试策略</description>

    <dependencies>
        <!--
          内网调用必须坐在平台基座之上：Result / InternalTokenSupport / RequestContextHolder
          都来自 starter，缺它就无法自动附加内网令牌与链路头。
        -->
        <dependency>
            <groupId>com.bluewhale</groupId>
            <artifactId>whale-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
