{
  "name": "common-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "公共能力包 · 与框架无关的工具集（日志 / 环境探测）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./logger": {
      "types": "./src/logger/index.ts",
      "import": "./src/logger/index.ts"
    },
    "./env": {
      "types": "./src/env/index.ts",
      "import": "./src/env/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "playground": "vite --config vite.playground.config.ts",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "stylelint": "stylelint \"src/**/*.{less,css}\" \"playground/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "common-config": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
