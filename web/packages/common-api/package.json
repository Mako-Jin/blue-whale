{
  "name": "common-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "前端契约包 · 类型全部由 docs/api/openapi.json 生成，接口形状零手写",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./log": {
      "types": "./src/log.ts",
      "import": "./src/log.ts"
    },
    "./events": {
      "types": "./src/events.ts",
      "import": "./src/events.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "gen:api": "openapi-typescript ../../../docs/api/openapi.json -o src/generated/schema.d.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "common-tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "common-config": "workspace:*",
    "eslint": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
