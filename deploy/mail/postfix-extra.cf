# ============================================================
# Postfix 出站中继配置（当云厂商封禁出站 25 端口时使用）
#
# 放置位置：mailcow-dockerized/data/conf/postfix/extra.cf
#           （mailcow 的 main.cf 会 include 该文件，改完执行
#            docker compose restart postfix-mailcow 生效）
#
# 适用判断：
#   - 出站 25 可达 → 不要用本文件，直投的信誉归自己，退信数据最直观
#   - 出站 25 被封（阿里云 / 腾讯云默认策略）→ 用本文件走 465/587 中继
#
# 三种组合二选一，不要同时启用（后写的覆盖前面的，容易配出半生效状态）
# ============================================================

# ------------------------------------------------------------
# 方案 A：中继走 465（隐式 TLS / SMTPS）
# 腾讯企业邮、阿里云 DirectMail 都支持，最省事，不用管 STARTTLS 协商
# ------------------------------------------------------------
relayhost = [smtp.exmail.qq.com]:465
smtp_tls_wrappermode = yes
smtp_tls_security_level = encrypt
smtp_sasl_auth_enable = yes
# static: 写法把凭据直接放进配置——文件权限必须是 600 且归 root
# 更稳妥的做法是用 texthash: 指向单独的口令文件，避免凭据进备份包
smtp_sasl_password_maps = static:noreply@example.com:REPLACE_WITH_SMTP_PASSWORD
smtp_sasl_security_options = noanonymous
# 中继偶尔抽风时不要把邮件丢在队列里反复重试到过期
smtp_connection_cache_on_demand = yes

# ------------------------------------------------------------
# 方案 B：中继走 587（STARTTLS）
# 部分服务商在 465 上限制并发，587 更宽松
# ------------------------------------------------------------
# relayhost = [smtpdm.aliyun.com]:587
# smtp_tls_security_level = encrypt
# smtp_sasl_auth_enable = yes
# smtp_sasl_password_maps = static:noreply@example.com:REPLACE_WITH_SMTP_PASSWORD
# smtp_sasl_security_options = noanonymous
# smtp_tls_wrappermode = no

# ------------------------------------------------------------
# 方案 C：仅系统通知走中继，员工邮箱直投
# 适用于出站 25 可用、但不希望员工邮箱的信誉与系统信绑在一起
# 用 sender_dependent_relayhost 按发件域分流
# ------------------------------------------------------------
# sender_dependent_relayhost_maps = texthash:/opt/postfix/conf/relay_by_sender
# smtp_sender_dependent_authentication = yes
# smtp_sasl_password_maps = texthash:/opt/postfix/conf/sasl_passwd
# 配套文件（同样放 data/conf/postfix/ 下）：
#   relay_by_sender:  noreply@example.com   [smtp.exmail.qq.com]:465
#   sasl_passwd:      [smtp.exmail.qq.com]:465   noreply@example.com:PASSWORD

# ------------------------------------------------------------
# 通用加固（与中继方案无关，建议保留）
# ------------------------------------------------------------
# 出站也要求对端支持 TLS，明文投递会被降级攻击利用
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_protocols = >=TLSv1.2
# 队列重试节奏：2 小时内每 15 分钟一次，之后放慢，5 天过期
maximal_queue_lifetime = 5d
bounce_queue_lifetime = 5d
