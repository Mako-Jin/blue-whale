# ============================================================
# BlueWhale — Git 换行符与文件属性规范
# ============================================================
# 统一以 LF 存入仓库、以 LF 检出，避免跨平台（Windows / macOS / Linux）
# 因换行符差异产生无意义的 diff，或导致 shell 脚本（husky 钩子、
# CI 脚本）在 Linux 上因 \r 而执行失败。
#
# 与 web/.editorconfig（end_of_line = lf）和 Prettier（endOfLine: lf）保持一致。
# ============================================================

# 默认：自动识别文本文件，一律使用 LF
* text=auto eol=lf

# ---- Windows 专有脚本必须保留 CRLF ----
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ---- 二进制文件不做任何换行转换 ----
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.jar   binary

# ---- 三维设计源（design/ 下的 Blender 工程与导出模型）----
*.blend  binary
*.blend1 binary
*.glb    binary
*.gltf   binary
*.fbx    binary
*.obj    binary

# ---- 生成物：不参与 diff 统计与语言统计 ----
web/pnpm-lock.yaml      -diff linguist-generated
web/packages/common-api/src/generated/**  linguist-generated
